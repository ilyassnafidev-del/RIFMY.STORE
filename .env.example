STORE_MODE=test
ADMIN_USER_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
BUSINESS_EMAIL=
LAUNCH_APPROVED=false

# Hostinger: point to durable private storage outside the deployment directory.
